  "t0_rules": {
    "description": "EGX T+0 intraday trading availability by market segment (per Feb 2024 restructure)",
    "t0_enabled_segments": [
      "high_activity",
      "moderate_activity",
      "egx30"
    ],
    "t1_only_segments": [
      "low_activity"
    ],
    "price_limits": {
      "high_activity": 0.2,
      "moderate_activity": 0.2,
      "low_activity": 0.05,
      "egx30": 0.3,
      "egx70": 0.15
    },
    "nuance": "T+0 stocks exhibit significantly higher volatility and sharper indicator reactions during first and last hours compared to T+1 tickers. High-momentum T+0 volumes drive VWAP/CMF/OBV reactions. EGX30 has highest liquidity; EGX70 intermediate; low_activity is T+1 only."
  },
